# ====================================================================
# 하늘고래 퀴즈 (Sky Whale Quiz) - Firebase Realtime Database 환경설정
# Vercel 환경 변수 및 로컬 .env 에 등록해 주세요.
# ====================================================================

# Firebase 프로젝트 웹 앱 설정값 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱에서 복사)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
# Realtime Database URL (예: https://whale-quiz-default-rtdb.asia-southeast1.firebasedatabase.app)
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# AI Studio 기본 환경변수
APP_URL="MY_APP_URL"
