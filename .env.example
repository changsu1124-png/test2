# Firebase Realtime Database & Auth Configuration
# Copy this file to .env.local for local testing and set the same keys in Vercel Project Settings -> Environment Variables.

# 1. Firebase Project Settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# 2. Firebase Realtime Database URL
# Example: https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=""

# Required by AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
