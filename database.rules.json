{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".write": "auth != null"
        },
        "state": {
          ".write": "auth != null"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "answers": {
          "$questionIndex": {
            "$uid": {
              ".write": "auth != null"
            }
          }
        }
      }
    }
  }
}
